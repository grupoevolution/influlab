# ============================================================
# InfluLab — variáveis de ambiente
# Cole TODAS estas variáveis no EasyPanel (Settings → Environment).
# ============================================================

# ===== Auth =====
# Segredo para assinar cookies de sessão. Em produção, troque por um valor
# aleatório próprio com: openssl rand -base64 32
AUTH_SECRET=influlab_secret_32chars_troque_em_producao_xK9pQ

# ===== Painel ADMIN (acesso total ao sistema) =====
# Use no /admin/login
ADMIN_EMAIL=admin@influlab.io
ADMIN_PASSWORD=InfluLab@Admin2026

# ===== Painel STAFF (apenas conteúdo — sem acessos/avisos/notificações/logs) =====
# Use no /staff/login
STAFF_EMAIL=staff@influlab.io
STAFF_PASSWORD=InfluLab@Staff2026

# ===== Emails sempre liberados (acesso de "comprador") =====
# Separe por vírgula. Funciona sem precisar passar pelo painel.
# Use estes para testar o app como aluno comprador.
DEFAULT_ALLOWED_EMAILS=comprador@influlab.io,demo@influlab.io,iago@influlab.io

# ===== Dados persistentes =====
# Caminho dentro do container onde o db.json é salvo.
# IMPORTANTE: no EasyPanel, configure um volume em /app/data!
DATA_DIR=/app/data
